{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alterno.dev/spatial-review/discovery/v1",
  "title": "Alterno Spatial Review discovery",
  "type": "object",
  "required": ["schema", "version", "name"],
  "properties": {
    "schema": { "const": "spatial-review-discovery/v1" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "websiteUrl": { "type": "string" },
    "scene": { "type": "string" },
    "assets": { "type": "string" },
    "liveCapture": { "type": "string" },
    "capabilities": {
      "type": "object",
      "properties": {
        "liveCapture": {
          "type": "object",
          "properties": {
            "editorOriginPolicy": { "$ref": "#/$defs/editorOriginPolicy" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "anyOf": [{ "required": ["scene"] }, { "required": ["assets"] }, { "required": ["liveCapture"] }],
  "allOf": [
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["liveCapture"],
            "properties": {
              "liveCapture": { "required": ["editorOriginPolicy"] }
            }
          }
        }
      },
      "then": { "required": ["liveCapture"] }
    }
  ],
  "$defs": {
    "editorOriginPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "origins"],
          "properties": {
            "mode": { "const": "allowlist" },
            "origins": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uri",
                "pattern": "^(?:https://[^/?#@*]+|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?)$"
              }
            },
            "allowLoopbackPeers": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["same-origin", "any"] },
            "allowLoopbackPeers": { "type": "boolean" }
          },
          "not": { "required": ["origins"] },
          "additionalProperties": true
        }
      ],
      "$comment": "Origin strings are semantically validated: no credentials, paths, queries, fragments, or wildcards; non-loopback origins require HTTPS."
    }
  },
  "additionalProperties": true
}
