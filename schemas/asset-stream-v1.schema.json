{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alterno.dev/spatial-review/asset-stream/v1",
  "title": "Alterno Spatial Review deferred asset streaming",
  "description": "Live structured-clone contract. Typed-array fields are not a static JSON snapshot encoding.",
  "oneOf": [
    { "$ref": "#/$defs/offer" },
    { "$ref": "#/$defs/streamDescriptor" },
    { "$ref": "#/$defs/sourceStatus" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/streamRequest" },
    { "$ref": "#/$defs/assetResponse" },
    { "$ref": "#/$defs/instanceData" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "offer": {
      "type": "object",
      "required": ["capability", "maxConcurrentRequests", "maxInFlightBytes"],
      "properties": {
        "capability": { "const": "asset-stream-v1" },
        "maxConcurrentRequests": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxInFlightBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
      },
      "additionalProperties": false
    },
    "representation": {
      "type": "object",
      "required": ["id", "purpose", "revision", "estimatedBytes", "attributes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "purpose": { "enum": ["overview", "detail"] },
        "revision": { "$ref": "#/$defs/revision" },
        "estimatedBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "triangles": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "instances": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "attributes": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["position", "normal", "uv", "color"] } },
        "geometricError": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "streamDescriptor": {
      "type": "object",
      "required": ["capability", "revision", "representations"],
      "properties": {
        "capability": { "const": "asset-stream-v1" },
        "revision": { "$ref": "#/$defs/revision" },
        "representations": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/representation" } }
      },
      "additionalProperties": true
    },
    "streamRequest": {
      "type": "object",
      "required": ["capability", "representationId", "maxBytes", "priority"],
      "properties": {
        "capability": { "const": "asset-stream-v1" },
        "representationId": { "$ref": "#/$defs/id" },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "priority": { "enum": ["interactive", "visible", "background"] },
        "knownRevision": { "$ref": "#/$defs/revision" }
      },
      "additionalProperties": false
    },
    "assetResponse": {
      "type": "object",
      "required": ["type", "requestId", "buildId", "assetId", "profile", "ok"],
      "properties": {
        "type": { "const": "alterno:spatial-review:asset-response" },
        "requestId": { "$ref": "#/$defs/id" },
        "buildId": { "$ref": "#/$defs/id" },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "profile": { "enum": ["scene", "review"] },
        "ok": { "type": "boolean" },
        "asset": { "type": "object" },
        "representationId": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "notModified": { "type": "boolean" },
        "error": { "enum": ["not-found", "too-large", "unavailable", "busy", "cancelled"] },
        "retryAfterMs": { "type": "integer", "minimum": 0, "maximum": 60000 }
      },
      "oneOf": [
        {
          "required": ["asset", "representationId", "revision"],
          "properties": { "ok": { "const": true }, "notModified": { "const": false } }
        },
        {
          "required": ["notModified", "representationId", "revision"],
          "properties": { "ok": { "const": true }, "notModified": { "const": true } },
          "not": { "required": ["asset"] }
        },
        {
          "required": ["error"],
          "properties": { "ok": { "const": false } },
          "not": { "required": ["asset"] }
        }
      ],
      "additionalProperties": true
    },
    "sourceStatus": {
      "type": "object",
      "required": ["type", "buildId", "catalogRevision", "phase"],
      "properties": {
        "type": { "const": "alterno:spatial-review:source-status" },
        "buildId": { "$ref": "#/$defs/id" },
        "catalogRevision": { "$ref": "#/$defs/revision" },
        "phase": { "enum": ["booting", "catalog-ready", "streaming", "complete", "error"] },
        "expectedActors": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "readyActors": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "activeRequests": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "message": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["type", "requestId", "buildId", "assetId", "representationId", "phase"],
      "properties": {
        "type": { "const": "alterno:spatial-review:asset-progress" },
        "requestId": { "$ref": "#/$defs/id" },
        "buildId": { "$ref": "#/$defs/id" },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "representationId": { "$ref": "#/$defs/id" },
        "phase": { "enum": ["queued", "generating", "serializing"] },
        "completed": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "required": ["type", "requestId", "buildId"],
      "properties": {
        "type": { "const": "alterno:spatial-review:asset-cancel" },
        "requestId": { "$ref": "#/$defs/id" },
        "buildId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "instanceData": {
      "type": "object",
      "required": ["encoding", "count", "transforms"],
      "properties": {
        "encoding": { "const": "matrix-f32-v1" },
        "count": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "transforms": { "description": "Float32Array with count * 16 finite entries." },
        "colors": { "description": "Optional Float32Array or Uint8Array with three or four channels per instance." },
        "stableIds": { "description": "Optional Uint32Array with one unique value per instance." },
        "selection": { "enum": ["aggregate", "instance"] }
      },
      "additionalProperties": false
    }
  }
}
